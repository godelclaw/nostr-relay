#!/usr/bin/env bash
# Write the relay's pubkey_whitelist from the public keys in the keys directory.
#
#   KEYS_DIR=<dir> scripts/sync-allowlist [--drop <avatar>]... <avatar> [avatar...]
#
# The allowlist IS access control -- the relay enforces it before accepting an
# event -- so it lives here, with the relay that reads it. The keys come from
# $KEYS_DIR/<avatar>/nostr-pubkey-hex, never from a screen or shell history:
# mint-avatar-keys (nostr-mailbox) writes the public halves there precisely so
# nothing has to be retyped. They are public, so reading them needs no gpg.
#
# It REFUSES to drop a key. The new block replaces the old one whole, so a caller
# that passes a short list -- a store missing some avatars, a typo, a fleet file
# half-written -- would lock everyone it left out off the relay at the next
# restart. A key already in config.toml stays unless its avatar is named with
# --drop (reap does that), or is listed again with a new key (a rotation: the
# new key replaces the old). A key in the block without a "# <avatar>" comment
# cannot be named, so it can only be removed by editing config.toml.
#
# A key from outside the fleet -- another operator's agent, added to config.toml
# by MR -- has no key file here. Its comment starts "# external:" and the line is
# kept as it is, after the fleet's keys. It too is removed only by editing
# config.toml. One key per line, as lowercase 64-hex: any other key (upper case,
# an npub) is refused, never dropped.
#
# Idempotent: rewrites the pubkey_whitelist block in place and leaves the rest of
# config.toml untouched. Restart the relay afterwards to load it.
set -euo pipefail

CONF="${CONF:-$(cd "$(dirname "$0")/.." && pwd)/config.toml}"
die() { echo "sync-allowlist: $*" >&2; exit 1; }

declare -A drop=()
declare -a names=()
while (( $# )); do
    case "$1" in
        --drop) shift; [[ -n "${1:-}" ]] || die "--drop needs an avatar name"; drop["$1"]=1 ;;
        -*) die "unknown option '$1'" ;;
        *) names+=( "$1" ) ;;
    esac
    shift
done

(( ${#names[@]} )) || { echo "usage: KEYS_DIR=<dir> $(basename "$0") [--drop <avatar>]... <avatar> [avatar...]" >&2; exit 2; }
[[ -n "${KEYS_DIR:-}" ]] || die "KEYS_DIR is not set -- the directory holding <avatar>/nostr-pubkey-hex"
[[ -d "$KEYS_DIR" ]] || die "no keys directory at $KEYS_DIR"
[[ -f "$CONF" ]] || die "no config.toml at $CONF"

block=""
declare -A want=() listed=()
for avatar in "${names[@]}"; do
    listed["$avatar"]=1
    [[ -z "${drop[$avatar]:-}" ]] || die "'$avatar' is both listed and dropped"
    hex=""
    [[ -s "$KEYS_DIR/$avatar/nostr-pubkey-hex" ]] && hex="$(head -1 "$KEYS_DIR/$avatar/nostr-pubkey-hex")"
    [[ "$hex" =~ ^[0-9a-f]{64}$ ]] || die "no usable $KEYS_DIR/$avatar/nostr-pubkey-hex -- mint first"
    block+="  \"$hex\",  # $avatar"$'\n'
    want["$hex"]=1
done

# External keys, kept verbatim. A fleet avatar holding the same key keeps it as its own.
declare -A ext=()
external=""
while IFS= read -r line; do
    [[ "$line" =~ \"([0-9a-f]{64})\" ]] || continue
    hex="${BASH_REMATCH[1]}"
    [[ -n "${want[$hex]:-}" || -n "${ext[$hex]:-}" ]] && continue
    ext["$hex"]=1
    external+="$line"$'\n'
done < <(awk '
    /^pubkey_whitelist[[:space:]]*=[[:space:]]*\[/ { inb=1; next }
    inb && /^\]/                                   { inb=0; next }
    inb && /#[[:space:]]*external:/' "$CONF")
block+="$external"

# The keys the block holds now, as "<hex> <avatar>" (avatar empty when uncommented).
lost=()
while read -r hex who; do
    [[ -n "${want[$hex]:-}" || -n "${ext[$hex]:-}" ]] && continue
    [[ -n "$who" && -n "${drop[$who]:-}" ]] && continue
    [[ -n "$who" && -n "${listed[$who]:-}" ]] && continue   # rotated: replaced, not dropped
    [[ "$who" == external:* ]] && who="external key $hex"
    lost+=( "${who:-<no comment> $hex}" )
done < <(awk '
    /^pubkey_whitelist[[:space:]]*=[[:space:]]*\[/ { inb=1; next }
    inb && /^\]/                                   { inb=0; next }
    inb && match($0, /"[^"]*"/) {
        hex=substr($0, RSTART+1, RLENGTH-2); who=""
        if (match($0, /#[[:space:]]*[^[:space:]]+/)) { who=substr($0, RSTART+1, RLENGTH-1); sub(/^[[:space:]]+/, "", who) }
        print hex, who }' "$CONF")
(( ${#lost[@]} == 0 )) \
    || die "refusing: this would drop $(printf '%s, ' "${lost[@]}" | sed 's/, $//') from $CONF -- name each with --drop <avatar> if that is meant"

tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
awk -v block="$block" '
    /^pubkey_whitelist[[:space:]]*=[[:space:]]*\[/ { print; printf "%s", block; skip=1; next }
    skip && /^\]/                                  { print; skip=0; next }
    !skip                                          { print }
' "$CONF" > "$tmp"

grep -q '^pubkey_whitelist' "$tmp" || die "pubkey_whitelist not found in $CONF"
cat "$tmp" > "$CONF"
echo "sync-allowlist: ${#names[@]} key(s) written to $CONF$( (( ${#ext[@]} )) && printf ', %s external kept' "${#ext[@]}")$( (( ${#drop[@]} )) && printf ', dropped: %s' "${!drop[*]}") -- restart the relay: docker compose restart"
